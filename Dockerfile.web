FROM golang:1.22-alpine AS builder

WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download

COPY cmd/ ./cmd/
COPY pkg/ ./pkg/
COPY web/public/ ./web/public/
RUN CGO_ENABLED=0 GOOS=linux go build -o gameoflife-web ./cmd/web

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /root/

COPY --from=builder /app/gameoflife-web ./web-server
RUN mkdir -p ./static/public
COPY --from=builder /app/web/public/ ./static/public/

EXPOSE 8080
CMD ["./web-server"]