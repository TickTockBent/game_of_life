FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy only source files needed for web service
COPY cmd/web/ ./cmd/web/
COPY pkg/ ./pkg/
COPY web/public/ ./web/public/

# Build with optimizations
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o gameoflife-web ./cmd/web

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /root/

COPY --from=builder /app/gameoflife-web ./web-server
RUN mkdir -p ./static/public
COPY --from=builder /app/web/public/ ./static/public/

EXPOSE 8080
CMD ["./web-server"]